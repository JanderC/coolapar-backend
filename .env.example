# Puerto del servidor
PORT=4000

# Entorno: development | production
NODE_ENV=development

# Conexion a la base de datos PostgreSQL
# En Railway esta variable se llama DATABASE_URL y se genera automaticamente
# al crear el servicio de Postgres. Copiala tal cual la de a Railway.
DATABASE_URL=postgresql://usuario:password@localhost:5432/coolapar

# JWT para autenticacion
JWT_SECRET=cambia_esto_por_un_secreto_seguro
JWT_EXPIRES_IN=8h

# Origen permitido para CORS (URL del frontend en Vercel)
CORS_ORIGIN=http://localhost:5173
